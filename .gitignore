# Godot import cache — machine-local, regenerated on every import.
# Never track this: it contains absolute paths and churns constantly.
.godot/

# Build output. Regenerated by tools/deploy_web.ps1 / the Godot export dialog.
# The web build alone is ~40 MB; it is published to the gh-pages branch, not main.
export/

# Editor / tooling leftovers
*.bak
*.tmp
__pycache__/
*.py[cod]

# Screenshots from tools/web_smoke.js
tools/.web_smoke/

# Review artefacts from tools/contact_sheet.py
tools/.review/

# Runtime save data. The game writes to user:// (AppData), but guard against
# copies dropped into the project root during debugging.
save.json
save.json.*
save.json*.bak
